def sn_cevir(x):
    """'H:MM:SS' -> saniye. DNF/DQ/boş -> NaN"""
    if not isinstance(x, str):
        return np.nan
    m = re.fullmatch(r"\s*(\d+):(\d{1,2}):(\d{1,2})\s*", x)
    if not m:
        return np.nan
    h, mi, s = map(int, m.groups())
    return h * 3600 + mi * 60 + s


def sn_yaz(sn):
    """saniye -> 'H:MM:SS'"""
    if pd.isna(sn):
        return ""
    sn = int(round(sn))
    return f"{sn // 3600}:{(sn % 3600) // 60:02d}:{sn % 60:02d}"


def tempo_yaz(sn_km):
    """sn/km -> 'M:SS /km'"""
    if pd.isna(sn_km):
        return ""
    sn_km = int(round(sn_km))
    return f"{sn_km // 60}:{sn_km % 60:02d}"


def zaman_formatla(df, kolonlar):
    d = df.copy()
    for c in kolonlar:
        if c in d.columns:
            d[c] = d[c].map(sn_yaz)
    return d


