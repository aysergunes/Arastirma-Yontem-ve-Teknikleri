def ikili_uclu(df, sonuc):
    baslik("2A) KATEGORİ + MESAFE")
    adet = pd.crosstab(df["Category"], df["Distance"], margins=True, margins_name="Toplam")
    print("Katılımcı sayısı:")
    print(adet.to_string())
    yuzde = (pd.crosstab(df["Category"], df["Distance"], normalize="columns") * 100).round(1)
    print("\nMesafe içinde kategori payı (%):")
    print(yuzde.to_string())
    ort = df[df["net_sn"].notna()].pivot_table(index="Category", columns="Distance",
                                                values="net_sn", aggfunc="mean")
    ort_g = ort.map(sn_yaz)
    print("\nOrtalama net süre:")
    print(ort_g.to_string())
    sonuc["2A_Kat_Mesafe_Adet"] = adet.reset_index()
    sonuc["2A_Kat_Mesafe_Pay"] = yuzde.reset_index()
    sonuc["2A_Kat_Mesafe_Sure"] = ort_g.reset_index()

    baslik("2B) KULÜP + KATEGORİ")
    top_kulup = df["Affiliation"].value_counts().head(10).index
    sub = df[df["Affiliation"].isin(top_kulup)]
    adet2 = pd.crosstab(sub["Affiliation"], sub["Category"], margins=True, margins_name="Toplam")
    print("En kalabalık 10 kulübün kategori dağılımı (sporcu sayısı):")
    print(adet2.to_string())

    # Kategori içi sıralama
    fin = df[df["net_sn"].notna()].copy()
    fin["kat_sira"] = fin.groupby("Category")["net_sn"].rank(method="min")
    fin["kat_ilk10"] = fin["kat_sira"] <= 10
    guc = (fin.groupby(["Affiliation", "Category"])
              .agg(Bitiren=("net_sn", "size"), Ort_Net=("net_sn", "mean"),
                   En_Iyi=("net_sn", "min"), Kat_Ilk10=("kat_ilk10", "sum"),
                   Ort_Kat_Sira=("kat_sira", "mean"))
              .reset_index())
    guc["Ort_Kat_Sira"] = guc["Ort_Kat_Sira"].round(1)
    guc_g = zaman_formatla(guc, ["Ort_Net", "En_Iyi"])
    print("\nKulübün kategori içi gücü (kategori ilk-10 sayısı, ort. kategori sırası):")
    print(guc_g.sort_values(["Kat_Ilk10", "Bitiren"], ascending=False).head(20).to_string(index=False))
    sonuc["2B_Kulup_Kat_Adet"] = adet2.reset_index()
    sonuc["2B_Kulup_Kat_Guc"] = guc_g.sort_values(["Kat_Ilk10", "Bitiren"], ascending=False)

    return fin


def kategori_ara_zaman(df, sonuc):
    baslik("2C) ARA ZAMAN (5 km, yarı, bitiş) + KATEGORİ  -  kim hızlı başladı, kim istikrarlı koştu?")
    d = df[df["net_sn"].notna() & df[KM5_COL + "_net"].notna() & df[HALF_COL + "_net"].notna()].copy()
    d["tempo_5k"] = d[KM5_COL + "_net"] / SPLIT_KM[KM5_COL]            # sn/km
    d["tempo_bitis"] = d["net_sn"] / YARIS_KM                           # sn/km (ortalama)
    d["ilk_yari"] = d[HALF_COL + "_net"]
    d["ikinci_yari"] = d["net_sn"] - d["ilk_yari"]
    d["split_orani"] = d["ikinci_yari"] / d["ilk_yari"]
    d["hizli_baslangic_%"] = (d["tempo_bitis"] / d["tempo_5k"] - 1) * 100   # +: ilk 5K ortalamadan hızlı

    rows = []
    for kat, g in d.groupby("Category"):
        r = {
            "Category": kat,
            "N": len(g),
            "Ort_5K_tempo": g["tempo_5k"].mean(),
            "Ort_Bitis_tempo": g["tempo_bitis"].mean(),
            "Hizli_Baslangic_%": g["hizli_baslangic_%"].mean(),
            "Ort_Split_Orani": g["split_orani"].mean(),
            "Negatif_Split_%": 100 * (g["split_orani"] < 1).mean(),
            "Korelasyon_5K_Bitis": g["tempo_5k"].corr(g["net_sn"]) if len(g) > 2 else np.nan,
        }
        rows.append(r)
    t = pd.DataFrame(rows).sort_values("N", ascending=False)
    for c in ["Ort_5K_tempo", "Ort_Bitis_tempo"]:
        t[c] = t[c].map(tempo_yaz)
    t = t.round(3)
    print("(tempo: dk:sn/km | Hizli_Baslangic_% : ilk 5 km, yarış ortalama temposundan % kaç hızlı)")
    print(t.to_string(index=False))
    print(f"\nGenel korelasyon (5K tempo vs bitiş süresi): {d['tempo_5k'].corr(d['net_sn']):.3f}")
    sonuc["2C_AraZaman_Kategori"] = t

    # Başlangıç tipi: kim hızlı başladı?
    d["Baslangic_Tipi"] = pd.cut(d["hizli_baslangic_%"], [-np.inf, -2, 2, np.inf],
                                 labels=["Yavaş başladı (>%2)", "Dengeli", "Hızlı başladı (>%2)"])
    ct = pd.crosstab(d["Category"], d["Baslangic_Tipi"], normalize="index").mul(100).round(1)
    print("\nKategoriye göre başlangıç tipi dağılımı (%):")
    print(ct.to_string())
    sonuc["2C_Baslangic_Tipi"] = ct.reset_index()
    return d



# 3) BÜTÜNSEL ANALİZ

def gun_vs_mat(df, sonuc):
    baslik("3A) GunTime vs Mattime  -  start çizgisi yoğunluğu (silah - çip farkı)")
    d = df[df["net_sn"].notna() & df["gun_sn"].notna()].copy()
    d["fark_sn"] = d["gun_sn"] - d["net_sn"]
    print(f"Hesaplanan sporcu: {len(d)}")
    print(f"Negatif fark (veri hatası olabilir): {(d['fark_sn'] < 0).sum()}")
    ozet = d["fark_sn"].describe(percentiles=[.1, .25, .5, .75, .9, .95, .99]).round(1)
    print(ozet.to_string())
    d["Sure_Grubu"] = pd.cut(d["net_sn"], SURE_GRUPLARI, labels=SURE_ETIKET, right=False)
    grup = (d.groupby("Sure_Grubu", observed=True)["fark_sn"]
              .agg(["count", "mean", "median", "max"]).round(1))
    grup.columns = ["Sporcu", "Ort_Fark_sn", "Medyan_Fark_sn", "Maks_Fark_sn"]
    print("\nBitiş süresi grubuna göre start farkı (sn):")
    print(grup.to_string())
    kor = d["fark_sn"].corr(d["net_sn"])
    kor_sp = d["fark_sn"].rank().corr(d["net_sn"].rank())   # Spearman (scipy gerektirmez)
    print(f"\nFark ile net süre korelasyonu: Pearson {kor:.3f} | Spearman {kor_sp:.3f}")
    print(f"Ortalama fark / net süre: %{100 * (d['fark_sn'] / d['net_sn']).mean():.2f}")
    print(f"Farkı 60 sn'yi aşan sporcu oranı: %{100 * (d['fark_sn'] > 60).mean():.1f}")
    sonuc["3A_GunMat_Ozet"] = ozet.reset_index()
    sonuc["3A_GunMat_Grup"] = grup.reset_index()

    fig, axs = plt.subplots(1, 2, figsize=(12, 4.5))
    ust = d["fark_sn"].quantile(0.99)
    axs[0].hist(d["fark_sn"].clip(upper=ust), bins=50, color="#4C78A8")
    axs[0].set_title("Silah - çip farkı dağılımı (sn, %99'a kırpıldı)")
    axs[0].set_xlabel("sn")
    axs[1].scatter(d["net_sn"] / 3600, d["fark_sn"].clip(upper=ust), s=6, alpha=.4, color="#E45756")
    axs[1].set_title("Bitiş süresi - start farkı")
    axs[1].set_xlabel("Net süre (saat)")
    axs[1].set_ylabel("sn")
    fig.tight_layout()
    fig.savefig(CIKTI / "03_gun_vs_mat.png", dpi=130)
    plt.close(fig)


def tempo_analizi(df, d_split, sonuc):
    baslik("3B) TEMPO ANALİZİ (Split Times)  -  negatif / pozitif split eğilimi")

    # --- Bölüm (segment) tempoları
    sira = [START_COL] + list(SPLIT_KM)
    km = {START_COL: 0.0, **SPLIT_KM}
    fin = df[df["net_sn"].notna()].copy()
    fin[START_COL + "_net"] = 0.0
    fin["BITIS_net"] = fin["net_sn"]
    noktalar = list(SPLIT_KM) + ["BITIS"]
    km["BITIS"] = YARIS_KM
    onceki = START_COL
    seg_rows, seg_tempo = [], pd.DataFrame(index=fin.index)
    for nokta in noktalar:
        a = (fin[onceki + "_net"] if onceki != START_COL else pd.Series(0.0, index=fin.index))
        b = fin[nokta + "_net"]
        mesafe = km[nokta] - km[onceki]
        isim = f"{km[onceki]:g}-{km[nokta]:g} km"
        tempo = (b - a) / mesafe
        tempo[(tempo < 120) | (tempo > 900)] = np.nan         # imkansız değerleri ele
        seg_tempo[isim] = tempo
        seg_rows.append({"Bolum": isim, "Mesafe_km": round(mesafe, 2), "N": tempo.notna().sum(),
                         "Ort_Tempo": tempo.mean(), "Medyan_Tempo": tempo.median()})
        onceki = nokta
    seg = pd.DataFrame(seg_rows)
    seg_g = seg.copy()
    seg_g["Ort_Tempo"] = seg_g["Ort_Tempo"].map(tempo_yaz)
    seg_g["Medyan_Tempo"] = seg_g["Medyan_Tempo"].map(tempo_yaz)
    print("Tüm bitirenler için bölüm tempoları (dk:sn / km):")
    print(seg_g.to_string(index=False))
    sonuc["3B_Bolum_Tempo"] = seg_g

    # --- Sürelere göre normalize tempo profili
    fin["Sure_Grubu"] = pd.cut(fin["net_sn"], SURE_GRUPLARI, labels=SURE_ETIKET, right=False)
    kendi_ort = fin["net_sn"] / YARIS_KM
    norm = seg_tempo.div(kendi_ort, axis=0)
    prof = norm.groupby(fin["Sure_Grubu"], observed=True).mean().mul(100).round(1)
    print("\nBitiş grubuna göre bölüm tempo endeksi (100 = kişinin kendi ortalama temposu; >100 yavaş):")
    print(prof.T.to_string())
    sonuc["3B_Tempo_Endeksi"] = prof.T.reset_index().rename(columns={"index": "Bolum"})

    # --- Split oranı
    s = fin[fin[HALF_COL + "_net"].notna()].copy()
    s["ilk"] = s[HALF_COL + "_net"]
    s["ikinci"] = s["net_sn"] - s["ilk"]
    s["oran"] = s["ikinci"] / s["ilk"]
    s = s[(s["oran"] > 0.5) & (s["oran"] < 3)]
    s["Tip"] = pd.cut(s["oran"], [0, NEG_ESIK, DENGE_ESIK, POZ_ESIK, np.inf],
                      labels=["Negatif split", "Dengeli", "Pozitif split", "Çöküş (>%10)"], right=False)
    tip = s["Tip"].value_counts().reindex(["Negatif split", "Dengeli", "Pozitif split", "Çöküş (>%10)"])
    tip_df = pd.DataFrame({"Sporcu": tip, "Yuzde": (100 * tip / tip.sum()).round(1)})
    print(f"\nSplit tipi dağılımı (N={len(s)}, oran = 2. yarı / 1. yarı):")
    print(tip_df.to_string())
    print(f"\nOrtalama split oranı: {s['oran'].mean():.3f} | medyan: {s['oran'].median():.3f}")
    print(f"Ortalama 1. yarı: {sn_yaz(s['ilk'].mean())} | ortalama 2. yarı: {sn_yaz(s['ikinci'].mean())}")
    print(f"Negatif split yapan (2. yarı < 1. yarı): %{100 * (s['oran'] < 1).mean():.1f}")

    s_grup = (s.groupby("Sure_Grubu", observed=True)
