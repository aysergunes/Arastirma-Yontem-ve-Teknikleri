def veri_yukle(yol):
    ham = pd.read_excel(yol, dtype=str)
    ham.columns = [c.strip() for c in ham.columns]
    n_ham = len(ham)

    # Boş satırlar ve tablonun altına yapıştırılmış artık satırlar atılır
    df = ham[ham["Distance"].notna() & ham["GogusNo"].notna()].copy()
    atilan_bos = n_ham - len(df)

    df = df[~df["Distance"].isin(EXCLUDE_DISTANCES)].copy()
    atilan_dist = (n_ham - atilan_bos) - len(df)

    for c in ["Distance", "Affiliation", "Category"]:
        df[c] = df[c].astype(str).str.strip()

    # Süreleri saniyeye çevir
    df["gun_sn"] = df["GunTime"].map(sn_cevir)
    df["net_sn"] = df["Mattime"].map(sn_cevir)
    for c in [START_COL] + list(SPLIT_KM):
        df[c + "_sn"] = df[c].map(sn_cevir)

    # Durum
    df["Durum"] = np.where(df["net_sn"].notna(), "Bitirdi",
                           df["Mattime"].fillna("Bilinmiyor").astype(str).str.upper())

    # Kategoriden cinsiyet ve yaş grubu türet
    df["Cinsiyet"] = df["Category"].str[0].where(df["Category"].str[0].isin(["M", "F"]), "?")
    yas = df["Category"].str.extract(r"([0-9]{2}.*)$")[0]
    df["YasGrubu"] = yas.fillna("Genel (yaş yok)")

    # Net-çip bazlı ara süreler /start mat'ı çıkarma
    for c in SPLIT_KM:
        df[c + "_net"] = df[c + "_sn"] - df[START_COL + "_sn"]

    print(f"Okunan satır: {n_ham}  |  boş/artık satır atıldı: {atilan_bos}  |  "
          f"hariç tutulan mesafe: {atilan_dist}  |  analiz edilen: {len(df)}")
    print(df["Durum"].value_counts().to_string())
    return df



# ORTAK ÖZET FONKSİYONU

def sure_ozeti(g):
    fin = g.loc[g["net_sn"].notna(), "net_sn"]
    return pd.Series({
        "Katilimci": len(g),
        "Bitiren": len(fin),
        "Bitirme_%": round(100 * len(fin) / len(g), 1) if len(g) else np.nan,
        "Ort_Net": fin.mean(),
        "Medyan_Net": fin.median(),
        "En_Iyi": fin.min(),
        "En_Yavas": fin.max(),
        "Std_dk": fin.std() / 60 if len(fin) > 1 else np.nan,
    })


ZAMAN_KOLONLARI = ["Ort_Net", "Medyan_Net", "En_Iyi", "En_Yavas"]


def grup_ozeti(df, anahtar):
    o = df.groupby(anahtar).apply(sure_ozeti, include_groups=False)
    o["Pay_%"] = (100 * o["Katilimci"] / o["Katilimci"].sum()).round(1)
    return o



